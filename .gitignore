# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ===== 虚拟环境 =====
.venv/
venv/
env/
ENV/

# ===== 密钥 / 环境变量（.env 含密钥，绝不能进仓库）=====
.env
*.env
!.env.tmpl
*.key
api.key
instana_api.key
instana.toml

# ===== stratus 内部：保留源码，忽略重型/生成物 =====
stratus/.venv/
stratus/AIOpsLab/
stratus/trace_output/
stratus/stratus_output/
stratus/metrics_output/
stratus/outputs/
stratus/eval/*/
stratus/kubectl_states/

# ===== 实验产物：默认全部忽略，按需放行 =====
artifacts/**

# 必须放行子目录，git 才能下钻到深层文件
!artifacts/**/

# planner_data：全部保留（训练数据集，444K）
!artifacts/planner_data/**

# artifacts 下所有 .md 文档都保留（模型权重/大文件仍忽略）
!artifacts/**/*.md

# ===== Claude 本地配置（整个目录忽略）=====
.claude/

# ===== 备份文件 =====
*.submitbak.*
*.fixbak.*
*.querybak.*
*.bak

# ===== 编辑器 / 系统 =====
.DS_Store
.vscode/
.idea/
*.log

# ===== 锁文件（poetry.lock 忽略；uv.lock 会正常提交）=====
poetry.lock
